SECRET_KEY=replace-with-a-long-random-secret
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1
CSRF_TRUSTED_ORIGINS=

GED_BASE_DIR=C:\TESTE\GED
SETORES_BASE_DIR=C:\TESTE\SETORES
LIXEIRA_DIR=C:\TESTE\GED_LIXEIRA
TRAMITACAO_DIR=C:\TESTE\TRAMITACAO
EVENTOS_DIR=D:\EVENTOS
ECARTA_DIR=D:\ECARTA
PONTO_DIR=D:\PONTO
GED_PF_GROUPS=GED_PESSOA_FISICA
GED_PJ_GROUPS=GED_PESSOA_JURIDICA
PONTO_RH_GROUPS=DEPARTAMENTO PESSOAL,DP,ADMINISTRATIVO,ADM
UPLOAD_MAX_SIZE=20971520
UPLOAD_ALLOWED_EXTENSIONS=.pdf,.doc,.docx,.xls,.xlsx,.csv,.png,.jpg,.jpeg,.gif,.txt

# E-mail de certificados (use o backend de console no desenvolvimento)
EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
EMAIL_HOST=
EMAIL_PORT=587
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
EMAIL_USE_TLS=True
EMAIL_USE_SSL=False
EMAIL_TIMEOUT=15
DEFAULT_FROM_EMAIL=no-reply@crfpb.org.br

# Production only
SECURE_SSL_REDIRECT=True
SECURE_HSTS_SECONDS=31536000